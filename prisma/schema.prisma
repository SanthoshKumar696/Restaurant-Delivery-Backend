// ============================================================================
// Prisma schema — Multi-tenant Restaurant Food Delivery Platform
// Source: 03-schema-v2(2).sql
// PostgreSQL + Prisma
// ============================================================================
// IMPORTANT:
// - PostgreSQL RLS policies remain in SQL migrations.
// - PostgreSQL partial/filtered indexes remain in SQL migrations because
//   Prisma schema cannot represent WHERE-filtered indexes.
// - PostgreSQL CHECK constraints not expressible by Prisma remain in SQL.
// - This schema mirrors the supplied SQL DDL and does not change its business model.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  TENANT_OWNER
  BRANCH_MANAGER
  STAFF
  CAPTAIN
  SUPPORT

  @@map("staff_role")
}

enum FulfillmentType {
  DELIVERY
  PICKUP

  @@map("fulfillment_type")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  REJECTED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("payment_status")
}

enum PaymentAttemptStatus {
  INITIATED
  SUCCESS
  FAILED
  CANCELLED

  @@map("payment_attempt_status")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  ABANDONED

  @@map("cart_status")
}

enum DiscountType {
  PERCENTAGE
  FLAT
  FREE_DELIVERY

  @@map("discount_type")
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  EXPIRE
  ADJUST

  @@map("loyalty_txn_type")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED

  @@map("delivery_status")
}

enum CampaignChannel {
  PUSH
  SMS
  EMAIL
  WHATSAPP

  @@map("campaign_channel")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  FAILED

  @@map("campaign_status")
}

enum RecipientStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED

  @@map("recipient_status")
}

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  WHATSAPP

  @@map("notification_channel")
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED

  @@map("notification_status")
}

model Tenant {
  id                       String                    @id @db.VarChar(20)
  name                     String                    @db.VarChar(150)
  slug                     String                    @unique @db.VarChar(100)
  logoUrl                  String?                   @map("logo_url") @db.Text
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenantSetting            TenantSetting?            @relation("TenantSettings_TenantId")
  branches                 Branch[]                  @relation("Branches_TenantId")
  branchSettings           BranchSetting[]           @relation("BranchSettings_TenantId")
  branchOperatingHours     BranchOperatingHour[]     @relation("BranchOperatingHours_TenantId")
  branchHolidays           BranchHoliday[]           @relation("BranchHolidays_TenantId")
  deliveryZones            DeliveryZone[]            @relation("DeliveryZones_TenantId")
  staffUsers               StaffUser[]               @relation("StaffUsers_TenantId")
  admins                   Admin[]                   @relation("Admins_TenantId")
  staffBranchAssignments   StaffBranchAssignment[]   @relation("StaffBranchAssignments_TenantId")
  customers                Customer[]                @relation("Customers_TenantId")
  customerAddresses        CustomerAddress[]         @relation("CustomerAddresses_TenantId")
  customerDeviceTokens     CustomerDeviceToken[]     @relation("CustomerDeviceTokens_TenantId")
  categories               Category[]                @relation("Categories_TenantId")
  products                 Product[]                 @relation("Products_TenantId")
  productVariants          ProductVariant[]          @relation("ProductVariants_TenantId")
  addonGroups              AddonGroup[]              @relation("AddonGroups_TenantId")
  addonGroupItems          AddonGroupItem[]          @relation("AddonGroupItems_TenantId")
  productAddonGroups       ProductAddonGroup[]       @relation("ProductAddonGroups_TenantId")
  branchProducts           BranchProduct[]           @relation("BranchProducts_TenantId")
  branchVariantOverrides   BranchVariantOverride[]   @relation("BranchVariantOverrides_TenantId")
  taxRules                 TaxRule[]                 @relation("TaxRules_TenantId")
  carts                    Cart[]                    @relation("Carts_TenantId")
  cartItems                CartItem[]                @relation("CartItems_TenantId")
  cartItemAddons           CartItemAddon[]           @relation("CartItemAddons_TenantId")
  orders                   Order[]                   @relation("Orders_TenantId")
  orderItems               OrderItem[]               @relation("OrderItems_TenantId")
  orderItemAddons          OrderItemAddon[]          @relation("OrderItemAddons_TenantId")
  orderStatusHistory       OrderStatusHistory[]      @relation("OrderStatusHistory_TenantId")
  paymentAttempts          PaymentAttempt[]          @relation("PaymentAttempts_TenantId")
  paymentWebhookEvents     PaymentWebhookEvent[]     @relation("PaymentWebhookEvents_TenantId")
  refunds                  Refund[]                  @relation("Refunds_TenantId")
  offers                   Offer[]                   @relation("Offers_TenantId")
  offerBranches            OfferBranch[]             @relation("OfferBranches_TenantId")
  offerProducts            OfferProduct[]            @relation("OfferProducts_TenantId")
  offerCategories          OfferCategory[]           @relation("OfferCategories_TenantId")
  offerRedemptions         OfferRedemption[]         @relation("OfferRedemptions_TenantId")
  coupons                  Coupon[]                  @relation("Coupons_TenantId")
  couponBranches           CouponBranch[]            @relation("CouponBranches_TenantId")
  couponProducts           CouponProduct[]           @relation("CouponProducts_TenantId")
  couponCategories         CouponCategory[]          @relation("CouponCategories_TenantId")
  couponRedemptions        CouponRedemption[]        @relation("CouponRedemptions_TenantId")
  loyaltyAccounts          LoyaltyAccount[]          @relation("LoyaltyAccounts_TenantId")
  loyaltyTransactions      LoyaltyTransaction[]      @relation("LoyaltyTransactions_TenantId")
  customerStats            CustomerStat[]            @relation("CustomerStats_TenantId")
  campaigns                Campaign[]                @relation("Campaigns_TenantId")
  campaignRecipients       CampaignRecipient[]       @relation("CampaignRecipients_TenantId")
  notificationLogs         NotificationLog[]         @relation("NotificationLogs_TenantId")
  captains                 Captain[]                 @relation("Captains_TenantId")
  captainBranchAssignments CaptainBranchAssignment[] @relation("CaptainBranchAssignments_TenantId")
  deliveries               Delivery[]                @relation("Deliveries_TenantId")
  captainLocations         CaptainLocation[]         @relation("CaptainLocations_TenantId")
  reviews                  Review[]                  @relation("Reviews_TenantId")
  banners                  Banner[]                  @relation("Banners_TenantId")
  dailyBranchSummary       DailyBranchSummary[]      @relation("DailyBranchSummary_TenantId")
  auditLogs                AuditLog[]                @relation("AuditLogs_TenantId")

  @@map("tenants")
}

model TenantSetting {
  tenantId             String   @id @map("tenant_id") @db.VarChar(20)
  currency             String   @default("INR") @db.VarChar(10)
  timezone             String   @default("Asia/Kolkata") @db.VarChar(50)
  deliveryEnabled      Boolean  @default(true) @map("delivery_enabled")
  pickupEnabled        Boolean  @default(true) @map("pickup_enabled")
  onlinePaymentEnabled Boolean  @default(true) @map("online_payment_enabled")
  codEnabled           Boolean  @default(false) @map("cod_enabled")
  loyaltyEnabled       Boolean  @default(true) @map("loyalty_enabled")
  offersEnabled        Boolean  @default(true) @map("offers_enabled")
  updatedAt            DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant   @relation("TenantSettings_TenantId", fields: [tenantId], references: [id])

  @@map("tenant_settings")
}

model Branch {
  id                       String                    @id @db.VarChar(20)
  tenantId                 String                    @map("tenant_id") @db.VarChar(20)
  name                     String                    @db.VarChar(150)
  addressLine              String                    @map("address_line") @db.Text
  city                     String?                   @db.VarChar(100)
  latitude                 Decimal?                  @db.Decimal(10, 7)
  longitude                Decimal?                  @db.Decimal(10, 7)
  phone                    String?                   @db.VarChar(20)
  deliveryEnabled          Boolean                   @default(true) @map("delivery_enabled")
  pickupEnabled            Boolean                   @default(true) @map("pickup_enabled")
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant                   Tenant                    @relation("Branches_TenantId", fields: [tenantId], references: [id])
  branchSetting            BranchSetting?            @relation("BranchSettings_BranchId")
  branchOperatingHours     BranchOperatingHour[]     @relation("BranchOperatingHours_BranchId")
  branchHolidays           BranchHoliday[]           @relation("BranchHolidays_BranchId")
  deliveryZones            DeliveryZone[]            @relation("DeliveryZones_BranchId")
  staffBranchAssignments   StaffBranchAssignment[]   @relation("StaffBranchAssignments_BranchId")
  branchProducts           BranchProduct[]           @relation("BranchProducts_BranchId")
  branchVariantOverrides   BranchVariantOverride[]   @relation("BranchVariantOverrides_BranchId")
  carts                    Cart[]                    @relation("Carts_BranchId")
  orders                   Order[]                   @relation("Orders_BranchId")
  offerBranches            OfferBranch[]             @relation("OfferBranches_BranchId")
  couponBranches           CouponBranch[]            @relation("CouponBranches_BranchId")
  customerStats            CustomerStat[]            @relation("CustomerStats_FavoriteBranchId")
  captainBranchAssignments CaptainBranchAssignment[] @relation("CaptainBranchAssignments_BranchId")
  reviews                  Review[]                  @relation("Reviews_BranchId")
  dailyBranchSummary       DailyBranchSummary[]      @relation("DailyBranchSummary_BranchId")

  @@index([tenantId], map: "idx_branches_tenant")
  @@map("branches")
}

model BranchSetting {
  branchId        String   @id @map("branch_id") @db.VarChar(20)
  tenantId        String   @map("tenant_id") @db.VarChar(20)
  minOrderValue   Decimal? @default(0) @map("min_order_value") @db.Decimal(10, 2)
  packagingCharge Decimal? @default(0) @map("packaging_charge") @db.Decimal(10, 2)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  branch          Branch   @relation("BranchSettings_BranchId", fields: [branchId], references: [id])
  tenant          Tenant   @relation("BranchSettings_TenantId", fields: [tenantId], references: [id])

  @@map("branch_settings")
}

model BranchOperatingHour {
  id        Int       @id @default(autoincrement())
  branchId  String    @map("branch_id") @db.VarChar(20)
  tenantId  String    @map("tenant_id") @db.VarChar(20)
  dayOfWeek Int       @map("day_of_week") @db.SmallInt
  opensAt   DateTime? @map("opens_at") @db.Time(6)
  closesAt  DateTime? @map("closes_at") @db.Time(6)
  isClosed  Boolean   @default(false) @map("is_closed")
  branch    Branch    @relation("BranchOperatingHours_BranchId", fields: [branchId], references: [id])
  tenant    Tenant    @relation("BranchOperatingHours_TenantId", fields: [tenantId], references: [id])

  @@unique([branchId, dayOfWeek])
  @@map("branch_operating_hours")
}

model BranchHoliday {
  id          Int      @id @default(autoincrement())
  branchId    String   @map("branch_id") @db.VarChar(20)
  tenantId    String   @map("tenant_id") @db.VarChar(20)
  holidayDate DateTime @map("holiday_date") @db.Date
  reason      String?  @db.VarChar(150)
  branch      Branch   @relation("BranchHolidays_BranchId", fields: [branchId], references: [id])
  tenant      Tenant   @relation("BranchHolidays_TenantId", fields: [tenantId], references: [id])

  @@unique([branchId, holidayDate])
  @@map("branch_holidays")
}

model DeliveryZone {
  id            Int      @id @default(autoincrement())
  branchId      String   @map("branch_id") @db.VarChar(20)
  tenantId      String   @map("tenant_id") @db.VarChar(20)
  name          String?  @db.VarChar(100)
  maxRadiusKm   Decimal? @map("max_radius_km") @db.Decimal(6, 2)
  deliveryFee   Decimal  @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  minOrderValue Decimal? @default(0) @map("min_order_value") @db.Decimal(10, 2)
  isActive      Boolean  @default(true) @map("is_active")
  branch        Branch   @relation("DeliveryZones_BranchId", fields: [branchId], references: [id])
  tenant        Tenant   @relation("DeliveryZones_TenantId", fields: [tenantId], references: [id])

  @@index([branchId], map: "idx_delivery_zones_branch")
  @@map("delivery_zones")
}

model Admin {
  id           Int      @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.VarChar(20)
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.Text
  name         String   @db.VarChar(150)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant   @relation("Admins_TenantId", fields: [tenantId], references: [id])

  @@index([tenantId], map: "idx_admins_tenant")
  @@map("admins")
}

model StaffUser {
  id                     Int                     @id @default(autoincrement())
  tenantId               String                  @map("tenant_id") @db.VarChar(20)
  fullName               String                  @map("full_name") @db.VarChar(150)
  phone                  String                  @db.VarChar(20)
  email                  String?                 @db.VarChar(150)
  passwordHash           String                  @map("password_hash") @db.Text
  role                   StaffRole
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant                 Tenant                  @relation("StaffUsers_TenantId", fields: [tenantId], references: [id])
  staffBranchAssignments StaffBranchAssignment[] @relation("StaffBranchAssignments_StaffId")
  orderStatusHistory     OrderStatusHistory[]    @relation("OrderStatusHistory_ChangedBy")
  offers                 Offer[]                 @relation("Offers_CreatedBy")
  coupons                Coupon[]                @relation("Coupons_CreatedBy")
  campaigns              Campaign[]              @relation("Campaigns_CreatedBy")
  notificationLogs       NotificationLog[]       @relation("NotificationLogs_StaffId")
  captain                Captain?                @relation("Captains_Id")
  auditLogs              AuditLog[]              @relation("AuditLogs_ActorStaffId")

  @@unique([tenantId, phone])
  @@index([tenantId], map: "idx_staff_tenant")
  @@map("staff_users")
}

model StaffBranchAssignment {
  id        Int       @id @default(autoincrement())
  staffId   Int       @map("staff_id")
  branchId  String    @map("branch_id") @db.VarChar(20)
  tenantId  String    @map("tenant_id") @db.VarChar(20)
  staffUser StaffUser @relation("StaffBranchAssignments_StaffId", fields: [staffId], references: [id])
  branch    Branch    @relation("StaffBranchAssignments_BranchId", fields: [branchId], references: [id])
  tenant    Tenant    @relation("StaffBranchAssignments_TenantId", fields: [tenantId], references: [id])

  @@unique([staffId, branchId])
  @@map("staff_branch_assignments")
}

model Customer {
  id                   Int                   @id @default(autoincrement())
  tenantId             String                @map("tenant_id") @db.VarChar(20)
  fullName             String?               @map("full_name") @db.VarChar(150)
  phone                String                @db.VarChar(20)
  dateOfBirth          DateTime?             @map("date_of_birth") @db.Date
  email                String?               @db.VarChar(150)
  passwordHash         String?               @map("password_hash") @db.Text
  referralCode         String?               @map("referral_code") @db.VarChar(20)
  referredBy           Int?                  @map("referred_by")
  isActive             Boolean               @default(true) @map("is_active")
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant                @relation("Customers_TenantId", fields: [tenantId], references: [id])
  customer             Customer?             @relation("Customers_ReferredBy", fields: [referredBy], references: [id])
  customersReferredBy  Customer[]            @relation("Customers_ReferredBy")
  customerAddresses    CustomerAddress[]     @relation("CustomerAddresses_CustomerId")
  customerDeviceTokens CustomerDeviceToken[] @relation("CustomerDeviceTokens_CustomerId")
  carts                Cart[]                @relation("Carts_CustomerId")
  orders               Order[]               @relation("Orders_CustomerId")
  offerRedemptions     OfferRedemption[]     @relation("OfferRedemptions_CustomerId")
  couponRedemptions    CouponRedemption[]    @relation("CouponRedemptions_CustomerId")
  loyaltyAccounts      LoyaltyAccount[]      @relation("LoyaltyAccounts_CustomerId")
  customerStats        CustomerStat[]        @relation("CustomerStats_CustomerId")
  campaignRecipients   CampaignRecipient[]   @relation("CampaignRecipients_CustomerId")
  notificationLogs     NotificationLog[]     @relation("NotificationLogs_CustomerId")
  reviews              Review[]              @relation("Reviews_CustomerId")

  @@unique([tenantId, phone])
  @@index([tenantId], map: "idx_customers_tenant")
  @@map("customers")
}

model CustomerAddress {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  tenantId    String   @map("tenant_id") @db.VarChar(20)
  label       String?  @db.VarChar(50)
  addressLine String   @map("address_line") @db.Text
  landmark    String?  @db.VarChar(150)
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer @relation("CustomerAddresses_CustomerId", fields: [customerId], references: [id])
  tenant      Tenant   @relation("CustomerAddresses_TenantId", fields: [tenantId], references: [id])

  @@index([customerId], map: "idx_customer_addresses_customer")
  @@map("customer_addresses")
}

model CustomerDeviceToken {
  id          Int      @id @default(autoincrement())
  customerId  Int      @map("customer_id")
  tenantId    String   @map("tenant_id") @db.VarChar(20)
  deviceToken String   @map("device_token") @db.Text
  platform    String?  @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer    Customer @relation("CustomerDeviceTokens_CustomerId", fields: [customerId], references: [id])
  tenant      Tenant   @relation("CustomerDeviceTokens_TenantId", fields: [tenantId], references: [id])

  @@unique([customerId, deviceToken])
  @@map("customer_device_tokens")
}

model Category {
  id                       Int              @id @default(autoincrement())
  tenantId                 String           @map("tenant_id") @db.VarChar(20)
  parentCategoryId         Int?             @map("parent_category_id")
  name                     String           @db.VarChar(100)
  displayOrder             Int              @default(0) @map("display_order")
  isActive                 Boolean          @default(true) @map("is_active")
  tenant                   Tenant           @relation("Categories_TenantId", fields: [tenantId], references: [id])
  category                 Category?        @relation("Categories_ParentCategoryId", fields: [parentCategoryId], references: [id])
  categoriesParentCategory Category[]       @relation("Categories_ParentCategoryId")
  products                 Product[]        @relation("Products_CategoryId")
  taxRules                 TaxRule[]        @relation("TaxRules_CategoryId")
  offerCategories          OfferCategory[]  @relation("OfferCategories_CategoryId")
  couponCategories         CouponCategory[] @relation("CouponCategories_CategoryId")

  @@index([tenantId], map: "idx_categories_tenant")
  @@map("categories")
}

model Product {
  id                 Int                 @id @default(autoincrement())
  tenantId           String              @map("tenant_id") @db.VarChar(20)
  categoryId         Int?                @map("category_id")
  name               String              @db.VarChar(150)
  description        String?             @db.Text
  imageUrl           String?             @map("image_url") @db.Text
  basePrice          Decimal             @map("base_price") @db.Decimal(10, 2)
  isVeg              Boolean             @default(true) @map("is_veg")
  isRecommended      Boolean             @default(false) @map("is_recommended")
  isBestSeller       Boolean             @default(false) @map("is_best_seller")
  displayOrder       Int                 @default(0) @map("display_order")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant             Tenant              @relation("Products_TenantId", fields: [tenantId], references: [id])
  category           Category?           @relation("Products_CategoryId", fields: [categoryId], references: [id])
  productVariants    ProductVariant[]    @relation("ProductVariants_ProductId")
  productAddonGroups ProductAddonGroup[] @relation("ProductAddonGroups_ProductId")
  branchProducts     BranchProduct[]     @relation("BranchProducts_ProductId")
  taxRules           TaxRule[]           @relation("TaxRules_ProductId")
  cartItems          CartItem[]          @relation("CartItems_ProductId")
  orderItems         OrderItem[]         @relation("OrderItems_ProductId")
  offerProducts      OfferProduct[]      @relation("OfferProducts_ProductId")
  couponProducts     CouponProduct[]     @relation("CouponProducts_ProductId")
  customerStats      CustomerStat[]      @relation("CustomerStats_FavoriteProductId")
  reviews            Review[]            @relation("Reviews_ProductId")

  @@index([tenantId], map: "idx_products_tenant")
  @@index([categoryId], map: "idx_products_category")
  @@map("products")
}

model ProductVariant {
  id                     Int                     @id @default(autoincrement())
  productId              Int                     @map("product_id")
  tenantId               String                  @map("tenant_id") @db.VarChar(20)
  name                   String                  @db.VarChar(100)
  price                  Decimal                 @db.Decimal(10, 2)
  isActive               Boolean                 @default(true) @map("is_active")
  displayOrder           Int                     @default(0) @map("display_order")
  product                Product                 @relation("ProductVariants_ProductId", fields: [productId], references: [id])
  tenant                 Tenant                  @relation("ProductVariants_TenantId", fields: [tenantId], references: [id])
  branchVariantOverrides BranchVariantOverride[] @relation("BranchVariantOverrides_VariantId")
  cartItems              CartItem[]              @relation("CartItems_VariantId")
  orderItems             OrderItem[]             @relation("OrderItems_VariantId")

  @@index([productId], map: "idx_variants_product")
  @@map("product_variants")
}

model AddonGroup {
  id                 Int                 @id @default(autoincrement())
  tenantId           String              @map("tenant_id") @db.VarChar(20)
  name               String              @db.VarChar(100)
  minSelect          Int                 @default(0) @map("min_select")
  maxSelect          Int                 @default(1) @map("max_select")
  isRequired         Boolean             @default(false) @map("is_required")
  tenant             Tenant              @relation("AddonGroups_TenantId", fields: [tenantId], references: [id])
  addonGroupItems    AddonGroupItem[]    @relation("AddonGroupItems_AddonGroupId")
  productAddonGroups ProductAddonGroup[] @relation("ProductAddonGroups_AddonGroupId")

  @@index([tenantId], map: "idx_addon_groups_tenant")
  @@map("addon_groups")
}

model AddonGroupItem {
  id             Int             @id @default(autoincrement())
  addonGroupId   Int             @map("addon_group_id")
  tenantId       String          @map("tenant_id") @db.VarChar(20)
  name           String          @db.VarChar(100)
  price          Decimal         @default(0) @db.Decimal(10, 2)
  isActive       Boolean         @default(true) @map("is_active")
  addonGroup     AddonGroup      @relation("AddonGroupItems_AddonGroupId", fields: [addonGroupId], references: [id])
  tenant         Tenant          @relation("AddonGroupItems_TenantId", fields: [tenantId], references: [id])
  cartItemAddons CartItemAddon[] @relation("CartItemAddons_AddonItemId")

  @@index([addonGroupId], map: "idx_addon_items_group")
  @@map("addon_group_items")
}

model ProductAddonGroup {
  id           Int        @id @default(autoincrement())
  productId    Int        @map("product_id")
  addonGroupId Int        @map("addon_group_id")
  tenantId     String     @map("tenant_id") @db.VarChar(20)
  product      Product    @relation("ProductAddonGroups_ProductId", fields: [productId], references: [id])
