  tenant     Tenant   @relation("CouponCategories_TenantId", fields: [tenantId], references: [id])
  coupon     Coupon   @relation("CouponCategories_CouponId", fields: [couponId], references: [id])
  category   Category @relation("CouponCategories_CategoryId", fields: [categoryId], references: [id])

  @@id([couponId, categoryId])
  @@unique([couponId, categoryId])
  @@unique([tenantId, couponId, categoryId])
  @@map("coupon_categories")
}

model CouponRedemption {
  id             Int      @id @default(autoincrement())
  couponId       Int      @map("coupon_id")
  tenantId       String   @map("tenant_id") @db.VarChar(20)
  orderId        Int      @map("order_id")
  customerId     Int      @map("customer_id")
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  coupon         Coupon   @relation("CouponRedemptions_CouponId", fields: [couponId], references: [id])
  tenant         Tenant   @relation("CouponRedemptions_TenantId", fields: [tenantId], references: [id])
  order          Order    @relation("CouponRedemptions_OrderId", fields: [orderId], references: [id])
  customer       Customer @relation("CouponRedemptions_CustomerId", fields: [customerId], references: [id])

  @@index([couponId, customerId], map: "idx_coupon_redemptions_customer")
  @@map("coupon_redemptions")
}

model LoyaltyAccount {
  id                  Int                  @id @default(autoincrement())
  tenantId            String               @map("tenant_id") @db.VarChar(20)
  customerId          Int                  @map("customer_id")
  balance             Int                  @default(0)
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant              Tenant               @relation("LoyaltyAccounts_TenantId", fields: [tenantId], references: [id])
  customer            Customer             @relation("LoyaltyAccounts_CustomerId", fields: [customerId], references: [id])
  loyaltyTransactions LoyaltyTransaction[] @relation("LoyaltyTransactions_LoyaltyAccountId")

  @@unique([tenantId, customerId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               Int            @id @default(autoincrement())
  loyaltyAccountId Int            @map("loyalty_account_id")
  tenantId         String         @map("tenant_id") @db.VarChar(20)
  orderId          Int?           @map("order_id")
  type             LoyaltyTxnType
  points           Int
  balanceAfter     Int            @map("balance_after")
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz(6)
  note             String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  loyaltyAccount   LoyaltyAccount @relation("LoyaltyTransactions_LoyaltyAccountId", fields: [loyaltyAccountId], references: [id])
  tenant           Tenant         @relation("LoyaltyTransactions_TenantId", fields: [tenantId], references: [id])
  order            Order?         @relation("LoyaltyTransactions_OrderId", fields: [orderId], references: [id])

  @@index([loyaltyAccountId], map: "idx_loyalty_txn_account")
  @@map("loyalty_transactions")
}

model CustomerStat {
  tenantId          String    @map("tenant_id") @db.VarChar(20)
  customerId        Int       @map("customer_id")
  totalOrders       Int       @default(0) @map("total_orders")
  totalSpend        Decimal   @default(0) @map("total_spend") @db.Decimal(12, 2)
  firstOrderAt      DateTime? @map("first_order_at") @db.Timestamptz(6)
  lastOrderAt       DateTime? @map("last_order_at") @db.Timestamptz(6)
  favoriteProductId Int?      @map("favorite_product_id")
  favoriteBranchId  String?   @map("favorite_branch_id") @db.VarChar(20)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant            Tenant    @relation("CustomerStats_TenantId", fields: [tenantId], references: [id])
  customer          Customer  @relation("CustomerStats_CustomerId", fields: [customerId], references: [id])
  product           Product?  @relation("CustomerStats_FavoriteProductId", fields: [favoriteProductId], references: [id])
  branch            Branch?   @relation("CustomerStats_FavoriteBranchId", fields: [favoriteBranchId], references: [id])

  @@id([tenantId, customerId])
  @@unique([tenantId, customerId])
  @@index([tenantId, lastOrderAt], map: "idx_customer_stats_last_order")
  @@index([tenantId, totalSpend], map: "idx_customer_stats_spend")
  @@map("customer_stats")
}

model Campaign {
  id                 Int                 @id @default(autoincrement())
  tenantId           String              @map("tenant_id") @db.VarChar(20)
  title              String              @db.VarChar(150)
  channel            CampaignChannel
  messageBody        String              @map("message_body") @db.Text
  targetSegment      String              @map("target_segment") @db.VarChar(30)
  scheduledAt        DateTime?           @map("scheduled_at") @db.Timestamptz(6)
  status             CampaignStatus      @default(DRAFT)
  createdBy          Int?                @map("created_by")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant              @relation("Campaigns_TenantId", fields: [tenantId], references: [id])
  staffUser          StaffUser?          @relation("Campaigns_CreatedBy", fields: [createdBy], references: [id])
  campaignRecipients CampaignRecipient[] @relation("CampaignRecipients_CampaignId")

  @@index([tenantId], map: "idx_campaigns_tenant")
  @@map("campaigns")
}

model CampaignRecipient {
  id          Int             @id @default(autoincrement())
  campaignId  Int             @map("campaign_id")
  tenantId    String          @map("tenant_id") @db.VarChar(20)
  customerId  Int             @map("customer_id")
  status      RecipientStatus @default(PENDING)
  sentAt      DateTime?       @map("sent_at") @db.Timestamptz(6)
  deliveredAt DateTime?       @map("delivered_at") @db.Timestamptz(6)
  readAt      DateTime?       @map("read_at") @db.Timestamptz(6)
  campaign    Campaign        @relation("CampaignRecipients_CampaignId", fields: [campaignId], references: [id])
  tenant      Tenant          @relation("CampaignRecipients_TenantId", fields: [tenantId], references: [id])
  customer    Customer        @relation("CampaignRecipients_CustomerId", fields: [customerId], references: [id])

  @@index([campaignId], map: "idx_campaign_recipients_campaign")
  @@map("campaign_recipients")
}

model NotificationLog {
  id                Int                 @id @default(autoincrement())
  tenantId          String              @map("tenant_id") @db.VarChar(20)
  customerId        Int?                @map("customer_id")
  staffId           Int?                @map("staff_id")
  channel           NotificationChannel
  type              String              @db.VarChar(50)
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(150)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant            Tenant              @relation("NotificationLogs_TenantId", fields: [tenantId], references: [id])
  customer          Customer?           @relation("NotificationLogs_CustomerId", fields: [customerId], references: [id])
  staffUser         StaffUser?          @relation("NotificationLogs_StaffId", fields: [staffId], references: [id])

  @@index([tenantId, customerId], map: "idx_notification_logs_tenant_customer")
  @@map("notification_logs")
}

model Captain {
  id                       Int                       @id
  tenantId                 String                    @map("tenant_id") @db.VarChar(20)
  vehicleType              String?                   @map("vehicle_type") @db.VarChar(50)
  vehicleNumber            String?                   @map("vehicle_number") @db.VarChar(20)
  currentStatus            String                    @default("OFFLINE") @map("current_status") @db.VarChar(20)
  staffUser                StaffUser                 @relation("Captains_Id", fields: [id], references: [id])
  tenant                   Tenant                    @relation("Captains_TenantId", fields: [tenantId], references: [id])
  captainBranchAssignments CaptainBranchAssignment[] @relation("CaptainBranchAssignments_CaptainId")
  deliveries               Delivery[]                @relation("Deliveries_CaptainId")
  captainLocations         CaptainLocation[]         @relation("CaptainLocations_CaptainId")

  @@map("captains")
}

model CaptainBranchAssignment {
  id        Int     @id @default(autoincrement())
  captainId Int     @map("captain_id")
  branchId  String  @map("branch_id") @db.VarChar(20)
  tenantId  String  @map("tenant_id") @db.VarChar(20)
  captain   Captain @relation("CaptainBranchAssignments_CaptainId", fields: [captainId], references: [id])
  branch    Branch  @relation("CaptainBranchAssignments_BranchId", fields: [branchId], references: [id])
  tenant    Tenant  @relation("CaptainBranchAssignments_TenantId", fields: [tenantId], references: [id])

  @@unique([captainId, branchId])
  @@map("captain_branch_assignments")
}

model Delivery {
  id               Int            @id @default(autoincrement())
  orderId          Int            @unique @map("order_id")
  tenantId         String         @map("tenant_id") @db.VarChar(20)
  captainId        Int?           @map("captain_id")
  status           DeliveryStatus @default(ASSIGNED)
  assignedAt       DateTime       @default(now()) @map("assigned_at") @db.Timestamptz(6)
  pickedUpAt       DateTime?      @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt      DateTime?      @map("delivered_at") @db.Timestamptz(6)
  distanceKm       Decimal?       @map("distance_km") @db.Decimal(6, 2)
  deliveryProofUrl String?        @map("delivery_proof_url") @db.Text
  order            Order          @relation("Deliveries_OrderId", fields: [orderId], references: [id])
  tenant           Tenant         @relation("Deliveries_TenantId", fields: [tenantId], references: [id])
  captain          Captain?       @relation("Deliveries_CaptainId", fields: [captainId], references: [id])

  @@index([captainId], map: "idx_deliveries_captain")
  @@map("deliveries")
}

model CaptainLocation {
  id         Int      @id @default(autoincrement())
  captainId  Int      @map("captain_id")
  tenantId   String   @map("tenant_id") @db.VarChar(20)
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  captain    Captain  @relation("CaptainLocations_CaptainId", fields: [captainId], references: [id])
  tenant     Tenant   @relation("CaptainLocations_TenantId", fields: [tenantId], references: [id])

  @@index([captainId, recordedAt], map: "idx_captain_locations_captain_time")
  @@map("captain_locations")
}

model Review {
  id            Int          @id @default(autoincrement())
  tenantId      String       @map("tenant_id") @db.VarChar(20)
  customerId    Int          @map("customer_id")
  orderId       Int?         @map("order_id")
  productId     Int?         @map("product_id")
  branchId      String?      @map("branch_id") @db.VarChar(20)
  rating        Int          @db.SmallInt
  comment       String?      @db.Text
  status        ReviewStatus @default(PENDING)
  adminResponse String?      @map("admin_response") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant        Tenant       @relation("Reviews_TenantId", fields: [tenantId], references: [id])
  customer      Customer     @relation("Reviews_CustomerId", fields: [customerId], references: [id])
  order         Order?       @relation("Reviews_OrderId", fields: [orderId], references: [id])
  product       Product?     @relation("Reviews_ProductId", fields: [productId], references: [id])
  branch        Branch?      @relation("Reviews_BranchId", fields: [branchId], references: [id])

  @@index([tenantId, productId], map: "idx_reviews_tenant_product")
  @@index([tenantId, branchId], map: "idx_reviews_tenant_branch")
  @@map("reviews")
}

model Banner {
  id           Int       @id @default(autoincrement())
  tenantId     String    @map("tenant_id") @db.VarChar(20)
  title        String    @db.VarChar(150)
  description  String?   @db.Text
  imageUrl     String?   @map("image_url") @db.Text
  offerText    String?   @map("offer_text") @db.VarChar(255)
  couponCode   String?   @map("coupon_code") @db.VarChar(50)
  startDate    DateTime? @map("start_date") @db.Timestamptz(6)
  endDate      DateTime? @map("end_date") @db.Timestamptz(6)
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant       Tenant    @relation("Banners_TenantId", fields: [tenantId], references: [id])

  @@index([tenantId], map: "idx_banners_tenant")
  @@index([isActive], map: "idx_banners_active")
  @@map("banners")
}

model DailyBranchSummary {
  id                Int      @id @default(autoincrement())
  tenantId          String   @map("tenant_id") @db.VarChar(20)
  branchId          String   @map("branch_id") @db.VarChar(20)
  summaryDate       DateTime @map("summary_date") @db.Date
  totalOrders       Int      @default(0) @map("total_orders")
  totalRevenue      Decimal  @default(0) @map("total_revenue") @db.Decimal(12, 2)
  totalGstCollected Decimal  @default(0) @map("total_gst_collected") @db.Decimal(12, 2)
  newCustomers      Int      @default(0) @map("new_customers")
  repeatCustomers   Int      @default(0) @map("repeat_customers")
  cancelledOrders   Int      @default(0) @map("cancelled_orders")
  tenant            Tenant   @relation("DailyBranchSummary_TenantId", fields: [tenantId], references: [id])
  branch            Branch   @relation("DailyBranchSummary_BranchId", fields: [branchId], references: [id])

  @@unique([tenantId, branchId, summaryDate])
  @@map("daily_branch_summary")
}

model AuditLog {
  id           Int        @id @default(autoincrement())
  tenantId     String?    @map("tenant_id") @db.VarChar(20)
  actorStaffId Int?       @map("actor_staff_id")
  action       String     @db.VarChar(50)
  entityType   String     @map("entity_type") @db.VarChar(50)
  entityId     String     @map("entity_id") @db.VarChar(100)
  oldData      Json?      @map("old_data") @db.JsonB
  newData      Json?      @map("new_data") @db.JsonB
  ipAddress    String?    @map("ip_address") @db.Inet
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant       Tenant?    @relation("AuditLogs_TenantId", fields: [tenantId], references: [id])
  staffUser    StaffUser? @relation("AuditLogs_ActorStaffId", fields: [actorStaffId], references: [id])

  @@index([tenantId, entityType, entityId], map: "idx_audit_logs_tenant_entity")
  @@map("audit_logs")
}
